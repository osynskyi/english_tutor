# Токен Telegram-бота от @BotFather (обязателен для бота)
BOT_TOKEN=

# Имя бота без @ — сайт покажет ссылку на бота (необязательно)
BOT_USERNAME=

# Публичный адрес сайта — бот покажет кнопку «Открыть сайт» (необязательно)
SITE_URL=

# Адрес и порт сайта
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Распознавание речи на сервере:
#   google  — бесплатный Google Web Speech API (нужен интернет)
#   whisper — офлайн-распознавание, нужно: pip install faster-whisper
STT_BACKEND=google
WHISPER_MODEL=base.en

# Акцент голоса озвучки (gTTS): com — американский, co.uk — британский, com.au — австралийский
TTS_TLD=com

# Папка для базы прогресса бота и кэша озвучки (по умолчанию ./data)
# DATA_DIR=./data
